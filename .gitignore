/jwt.key

# Local environment generated by the Docker deployment (contains passwords/keys, not committed)
.env

# Event logs produced by scheduler runs/simulations (test artifacts, not committed)
*-events.csv

# bench benchmark-related files (local artifacts, not committed)
/bench/
/Dockerfile.bench
/Dockerfile.bench.v2